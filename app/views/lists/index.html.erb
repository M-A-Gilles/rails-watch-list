<div class="hero-banner d-flex flex-column align-items-center justify-content-center text-center text-white">
  <h1 class="display-5 fw-bold">Save any kind of movies</h1>
</div>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Lists</h2>
    <%= link_to "Create a movie list", new_list_path, class: "btn btn-success" %>
  </div>

  <div class="row">
    <% @lists.each do |list| %>
      <div class="col-md-4 mb-4">
        <%= link_to list_path(list), class: "text-decoration-none text-white" do %>
          <div class="list-card d-flex align-items-end p-3">
            <h4 class="fw-bold mb-0"><%= list.name %></h4>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= cl_image_tag("h86jhfm7h9mvhztf2y0v",
      width: 400, height: 300, crop: :fill) %>
  </div>
</div>
